# Supabase PostgreSQL connection used by the app at runtime.
# Use a PostgreSQL connection string from Supabase, not the public project API URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"

# Direct Supabase PostgreSQL connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"

# JWT_SECRET signs the local login session cookie.
# Use a long random value in real deployments.
JWT_SECRET="replace-this-with-a-long-random-secret"

# Optional. When absent, AI routes use deterministic seeded fallback data.
OPENAI_API_KEY=""
