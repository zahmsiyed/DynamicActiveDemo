# Prisma reads DATABASE_URL to know where the local SQLite database lives.
# The relative path is resolved from the prisma/schema.prisma file, so this
# creates the database at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# JWT_SECRET signs the local login session cookie.
# Use a long random value in real deployments.
JWT_SECRET="replace-this-with-a-long-random-secret"
